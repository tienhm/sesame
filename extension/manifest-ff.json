{
  "manifest_version": 3,
  "name": "Sesame Pass",
  "version": "1.6.1",
  "description": "Auto-fill usernames and passwords from Sesame into web forms.",
  "browser_specific_settings": {
    "gecko": {
      "id": "sesame-pass@szm",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    }
  },
  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "64":  "icons/icon64.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sesame Pass",
    "default_icon": {
      "16": "icons/gray/icon16.png",
      "32": "icons/gray/icon32.png",
      "48": "icons/gray/icon48.png"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "alarms", "nativeMessaging"]
}
